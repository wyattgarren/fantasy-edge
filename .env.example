# Copy to .env and uncomment what you want to change. All vars have safe
# defaults; the app works fully with none of this set. See data/config.py.

# Optional AI explanations: set to "ollama" to have a local Ollama model
# turn computed verdicts into a short paragraph. Leave unset (recommended
# on Streamlit Cloud, where Ollama isn't reachable) to use plain template
# sentences -- the app is fully functional either way.
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=8

# Boot every new session straight into demo mode (useful for a dedicated,
# friends-only Streamlit Cloud deployment). Users can always reach the demo
# via the "Try the demo" button or a ?demo=1 link regardless of this.
# DEMO_MODE=1

# Where the Sleeper /players/nfl response is cached on disk.
# SLEEPER_CACHE_DIR=.cache
